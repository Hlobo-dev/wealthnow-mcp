{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.wealthnow/mcp",
  "title": "Wealthnow",
  "description": "Institutional financial data for agents: bond prints, CDS, private markets, options history, 13F.",
  "version": "2.138.2",
  "websiteUrl": "https://app.wealthnow.io/docs/mcp-and-sdks",
  "repository": {
    "url": "https://github.com/Hlobo-dev/wealthnow-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://app.wealthnow.io/favicon/favicon-light.svg",
      "mimeType": "image/svg+xml",
      "theme": "light",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://app.wealthnow.io/favicon/favicon-dark.svg",
      "mimeType": "image/svg+xml",
      "theme": "dark",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://app.wealthnow.io/tengu-logo-light.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ],
      "theme": "light"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.wealthnow.io/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Your Wealthnow API key (tengu_...). Apps that sign in with MCP OAuth (Claude, ChatGPT, Codex, Cursor, VS Code, Zed, GitHub Copilot CLI, Goose, Gemini CLI and others) need no key. Use a key for scripts, or for an app whose sign-in does not finish yet (the docs list them).",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}

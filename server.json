{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.wealthnow/mcp",
  "title": "Wealthnow",
  "description": "Market data MCP for AI agents: prices, fundamentals, SEC filings, 13F, insider, options, credit",
  "version": "2.162.0",
  "websiteUrl": "https://app.wealthnow.io/docs/mcp-and-sdks",
  "repository": {
    "url": "https://github.com/Hlobo-dev/wealthnow-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/Hlobo-dev/wealthnow-mcp/main/assets/wealthnow-logo-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://app.wealthnow.io/favicon/favicon-light.svg",
      "mimeType": "image/svg+xml",
      "theme": "light",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://app.wealthnow.io/favicon/favicon-dark.svg",
      "mimeType": "image/svg+xml",
      "theme": "dark",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.wealthnow.io/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Optional. OAuth is supported: apps with MCP OAuth (Claude, ChatGPT, Cursor, VS Code and others) sign in through the browser and need no key. For scripts and apps without OAuth, send your Wealthnow API key here (also accepted as Authorization: Bearer).",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
